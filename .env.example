# Base de datos
# Railway la inyecta automáticamente cuando conectas el plugin PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/apolodigital

# Seguridad — genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-de-64-caracteres-minimo

# Entorno: development | production
ENVIRONMENT=development
DEBUG=false

# Token JWT en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
